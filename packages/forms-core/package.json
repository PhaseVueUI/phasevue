{
    "name": "@phasevueui/forms-core",
    "version": "0.0.1-alpha.1",
    "author": "PhaseVue UI",
    "description": "Framework-agnostic form validation utilities for PhaseVue",
    "homepage": "https://phasevue.org/",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/PhaseVueUI/phasevue.git",
        "directory": "packages/forms-core"
    },
    "bugs": {
        "url": "https://github.com/PhaseVueUI/phasevue/issues"
    },
    "main": "./dist/index.mjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.mts",
    "exports": {
        ".": {
            "types": "./dist/index.d.mts",
            "import": "./dist/index.mjs",
            "default": "./dist/index.mjs"
        },
        "./*": {
            "types": "./dist/*/index.d.mts",
            "import": "./dist/*/index.mjs",
            "default": "./dist/*/index.mjs"
        }
    },
    "publishConfig": {
        "main": "./index.mjs",
        "module": "./index.mjs",
        "types": "./index.d.mts",
        "exports": {
            ".": {
                "types": "./index.d.mts",
                "import": "./index.mjs",
                "default": "./index.mjs"
            },
            "./*": {
                "types": "./*/index.d.mts",
                "import": "./*/index.mjs",
                "default": "./*/index.mjs"
            }
        },
        "directory": "dist",
        "linkDirectory": false,
        "access": "public"
    },
    "sideEffects": false,
    "files": [
        "dist",
        "README.md",
        "LICENSE.md"
    ],
    "scripts": {
        "build": "NODE_ENV=production INPUT_DIR=src/ OUTPUT_DIR=dist/ pnpm run build:package",
        "build:package": "pnpm run build:prebuild && tsup && pnpm run build:postbuild",
        "build:prebuild": "node ./scripts/prebuild.mjs",
        "build:postbuild": "node ./scripts/postbuild.mjs",
        "dev:link": "pnpm link --global && npm link"
    },
    "dependencies": {
        "@phasevueui/utils": "workspace:*"
    },
    "peerDependencies": {
        "joi": ">=17",
        "superstruct": ">=2",
        "valibot": ">=0.42",
        "yup": ">=1",
        "zod": ">=3"
    },
    "peerDependenciesMeta": {
        "joi": {
            "optional": true
        },
        "superstruct": {
            "optional": true
        },
        "valibot": {
            "optional": true
        },
        "yup": {
            "optional": true
        },
        "zod": {
            "optional": true
        }
    },
    "devDependencies": {
        "tsup": "^8.1.0"
    },
    "engines": {
        "node": ">=12.11.0"
    }
}
