{
    "name": "@phasevueui/utils",
    "version": "0.0.1-alpha.1",
    "author": "PhaseVue UI",
    "description": "Utility functions and helpers for PhaseVue",
    "homepage": "https://phasevue.org/",
    "keywords": ["utilities", "helpers", "phasevue"],
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/PhaseVueUI/phasevue.git",
        "directory": "packages/utils"
    },
    "bugs": {
        "url": "https://github.com/PhaseVueUI/phasevue/issues"
    },
    "main": "./dist/index.mjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.mts",
    "exports": {
        ".": {
            "types": "./dist/index.d.mts",
            "import": "./dist/index.mjs",
            "default": "./dist/index.mjs"
        },
        "./*": {
            "types": "./dist/*/index.d.mts",
            "import": "./dist/*/index.mjs",
            "default": "./dist/*/index.mjs"
        }
    },
    "publishConfig": {
        "main": "./index.mjs",
        "module": "./index.mjs",
        "types": "./index.d.mts",
        "exports": {
            ".": {
                "types": "./index.d.mts",
                "import": "./index.mjs",
                "default": "./index.mjs"
            },
            "./*": {
                "types": "./*/index.d.mts",
                "import": "./*/index.mjs",
                "default": "./*/index.mjs"
            }
        },
        "directory": "dist",
        "linkDirectory": false,
        "access": "public"
    },
    "sideEffects": false,
    "files": ["dist", "README.md", "LICENSE"],
    "scripts": {
        "build": "NODE_ENV=production INPUT_DIR=src/ OUTPUT_DIR=dist/ pnpm run build:package",
        "build:dev": "NODE_ENV=development INPUT_DIR=src/ OUTPUT_DIR=dist/ pnpm run build:dev:package",
        "build:package": "pnpm run build:prebuild && tsup",
        "build:dev:package": "pnpm run build:prebuild && tsup --watch",
        "build:prebuild": "node ./scripts/prebuild.mjs",
        "dev:link": "pnpm link --global && npm link"
    },
    "devDependencies": {
        "tsup": "^8.1.0"
    },
    "engines": {
        "node": ">=12.11.0"
    }
}
