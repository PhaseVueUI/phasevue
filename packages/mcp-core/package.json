{
    "name": "@phasevueui/mcp-core",
    "version": "0.0.1-alpha.1",
    "author": "PhaseVue UI",
    "description": "Framework-agnostic MCP utilities boundary for PhaseVue",
    "homepage": "https://phasevue.org/",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/PhaseVueUI/phasevue.git",
        "directory": "packages/mcp-core"
    },
    "bugs": {
        "url": "https://github.com/PhaseVueUI/phasevue/issues"
    },
    "type": "module",
    "main": "./src/index.ts",
    "module": "./src/index.ts",
    "types": "./src/index.ts",
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "import": "./src/index.ts",
            "default": "./src/index.ts"
        }
    },
    "publishConfig": {
        "access": "public"
    },
    "sideEffects": false,
    "files": [
        "dist",
        "README.md",
        "LICENSE.md"
    ],
    "scripts": {
        "build": "NODE_ENV=production INPUT_DIR=src/ OUTPUT_DIR=dist/ pnpm run build:package",
        "build:package": "pnpm run build:prebuild && tsup && pnpm run build:postbuild",
        "build:prebuild": "node ./scripts/prebuild.mjs",
        "build:postbuild": "node ./scripts/postbuild.mjs"
    },
    "dependencies": {
        "@primeuix/mcp": "catalog:"
    },
    "devDependencies": {
        "tsup": "^8.1.0"
    },
    "engines": {
        "node": ">=12.11.0"
    }
}
